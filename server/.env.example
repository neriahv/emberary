# Copy to .env and fill in. .env is git-ignored; this file is committed.
# On a deployed host, set these in the dashboard instead: there is no .env there.

# Local (page 4):    postgresql://postgres:devpassword@localhost:5432/emberary
# Hosted (page 5):   postgresql://user:pass@host.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:devpassword@localhost:5432/emberary

# Comma-separated, no trailing slash, no path. An origin is scheme + host + port.
CORS_ORIGINS=http://localhost:5173

# Set to production on your host. Express and several libraries behave better,
# including not sending stack traces to your users.
NODE_ENV=development

# Do NOT set PORT locally or on the host. The host sets it for you.

# Only for "npm run covers:fetch", which looks up each book's cover once and
# saves the public image links. The API never uses it, and it must never go in
# a VITE_ variable: those are compiled into the public JavaScript.
# Get one at https://console.cloud.google.com/apis/credentials (enable the
# Books API) and restrict it to the Books API.
GOOGLE_BOOKS_API_KEY=
